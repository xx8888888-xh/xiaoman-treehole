# 小满树洞 · 环境变量示例（复制为 .env；真实 key 绝不提交）
# cp .env.example .env

# ---------- 主通道：Kilo 网关（免 Key，零成本，实测 200 / cost=0） ----------
AI_MODE=openai
AI_API_BASE=https://api.kilo.ai/api/gateway
AI_API_KEY=
AI_MODEL=nvidia/nemotron-3.5-lightning:free

# ---------- 备选通道：OpenRouter（需 Key；免费额度 50 次/天，仅作兜底） ----------
# AI_MODE=openai
# AI_API_BASE=https://openrouter.ai/api/v1
# AI_API_KEY=            # 从 Windows 凭据管理器运行时注入，禁止写进代码/提交
# AI_MODEL=nvidia/nemotron-3.5-lightning:free

# ---------- 本地 mock（无网络也能全功能跑通） ----------
# AI_MODE=mock

# ---------- 语音 ----------
TTS_BASE=http://127.0.0.1:8903
TTS_VOICE=zh-CN-XiaoyiNeural

# ---------- 可选（一般不用改） ----------
# CORS 白名单，逗号分隔；默认只允许本机前端站点
# XIAOMAN_ALLOW_ORIGINS=http://127.0.0.1:8901
# TTS 缓存目录（容器内默认 /data/tts，已挂 volume）
# TTS_CACHE_DIR=/data/tts
