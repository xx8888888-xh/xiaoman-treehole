# 小满树洞 · 环境变量示例（复制为 .env；真实 key 绝不提交）
# cp .env.example .env

# ---------- 主通道：Kilo 网关（免 Key，零成本，实测 200 / cost=0） ----------
AI_MODE=openai
AI_API_BASE=https://api.kilo.ai/api/gateway
AI_API_KEY=
AI_MODEL=nvidia/nemotron-3.5-lightning:free

# ---------- 备选通道：OpenRouter（需 Key；免费额度 50 次/天，仅作兜底） ----------
# AI_MODE=openai
# AI_API_BASE=https://openrouter.ai/api/v1
# AI_API_KEY=            # 留空即可：Windows 下会自动从凭据管理器读取；禁止写进代码/提交
# AI_MODEL=nvidia/nemotron-3.5-lightning:free
# 凭据管理器中要读取的通用凭据 Target（默认 Freebuff BYOK 写入的那条）
# AI_KEY_CREDENTIAL_TARGET=com.freebuff.byok.v1/connection:360e4a4c-f084-4d80-adf1-dac59a44b450:1

# ---------- 本地 mock（无网络也能全功能跑通） ----------
# AI_MODE=mock

# ---------- 语音 ----------
TTS_BASE=http://127.0.0.1:8903
TTS_VOICE=zh-CN-XiaoyiNeural
# 服务端合成后端：none（默认，不合成，/tts 回 503 由系统 TTS 接管）/ cmd / sherpa
# XIAOMAN_TTS_PROVIDER=none
# provider=cmd 时的本地 TTS 命令（文本走 stdin、音频走 stdout；可用 sherpa-onnx CLI）
# XIAOMAN_TTS_CMD=/path/to/tts-cli
# provider=sherpa 时自备模型（不会联网下载；模型许可自行确认）
# XIAOMAN_TTS_SHERPA_MODEL=/models/model.onnx
# XIAOMAN_TTS_SHERPA_TOKENS=/models/tokens.txt

# ---------- 可选（一般不用改） ----------
# CORS 白名单，逗号分隔；默认只允许本机前端站点
# XIAOMAN_ALLOW_ORIGINS=http://127.0.0.1:8901
# TTS 缓存目录（容器内默认 /data/tts，已挂 volume）
# TTS_CACHE_DIR=/data/tts
