# 构建产物（APK 保留在 outputs 里，中间物不入库）
android/app/build/
android/local.properties
android/.gradle/
.gradle/

# 本地环境与密钥（严禁入库）
upload/
*.local
*.env
.env
*_token*
.git_askpass*
node_modules/

# 备份归档与打包产物（体积大，不入库）
backups/
*.apk
*.aab

# Python 缓存与脚本自测临时产物
__pycache__/
*.pyc
# 脚本自测/校验的临时产物目录（不再写入 web/assets/audio/）
.cache/
web/assets/audio/selftest*.mp3
web/assets/audio/selftest*.wav

# 本地服务运行日志（dev_up.sh 产物）
logs/

# 系统
.DS_Store
